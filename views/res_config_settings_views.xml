<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_stock_control" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.stock.control</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="after">
                <block title="Control de stock en el POS" id="pos_stock_control_section">
                    <setting string="Mostrar stock en el POS"
                             help="Muestra la cantidad disponible en cada producto de la pantalla de venta.">
                        <field name="pos_show_stock_in_pos"/>
                    </setting>
                    <setting string="Bloquear venta sin stock"
                             help="No permite vender más unidades de las que hay en el almacén del POS.">
                        <field name="pos_block_sale_without_stock"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
