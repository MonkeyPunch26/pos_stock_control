<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_stock_control.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//article" position="inside">
            <span t-if="props.stock !== undefined"
                  t-attf-class="position-absolute top-0 end-0 m-1 badge {{ props.stock > 0 ? 'text-bg-success' : 'text-bg-danger' }}"
                  t-esc="props.stock"/>
        </xpath>
    </t>
</templates>
